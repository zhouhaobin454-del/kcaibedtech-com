Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Legacy contact page had no working form handler; send visitors to the live inquiry form
  RewriteRule ^contact/?$ /contact.html [R=301,L,QSA]
  # Legacy pages that now have a rebuilt equivalent: consolidate to the new URLs
  RewriteRule ^about/?$ /about.html [R=301,L,QSA]
  RewriteRule ^products/?$ /products.html [R=301,L,QSA]
  RewriteRule ^privacy/?$ /privacy-policy.html [R=301,L,QSA]
  RewriteRule ^blog/?$ /news.html [R=301,L,QSA]
  RewriteRule ^blog/adjustable-bed-base-bed-frame-compatibility/?$ /blog/adjustable-frame-mattress-fit-checklist/ [R=301,L]
  RewriteRule ^blog/adjustable-bed-base-manufacturer-china-b2b-guide/?$ /blog/choosing-adjustable-bed-factory-china/ [R=301,L]
  RewriteRule ^blog/adjustable-bed-base-oem-sampling-b2b-guide/?$ /blog/adjustable-frame-sample-approval-checklist/ [R=301,L]
  RewriteRule ^blog/adjustable-bed-base-rfq-checklist-b2b-guide/?$ /blog/writing-an-adjustable-frame-rfq/ [R=301,L]
  RewriteRule ^blog/adjustable-bed-features-b2b-guide/?$ /blog/adjustable-bed-functions-for-buyers/ [R=301,L]
  RewriteRule ^blog/split-king-vs-king-adjustable-bed-bases/?$ /blog/split-king-or-king-frame-sizing/ [R=301,L]
  RewriteRule ^blog/wall-hugger-adjustable-bed-base-b2b-guide/?$ /blog/zero-clearance-frame-buyer-notes/ [R=302,L]
  RewriteRule ^blog/why-are-adjustable-bed-bases-so-heavy/?$ /blog/why-adjustable-frames-weigh-so-much/ [R=301,L]
  RewriteRule ^blog/zero-clearance-adjustable-bed-base-b2b-guide/?$ /blog/zero-clearance-frame-buyer-notes/ [R=301,L]

  # 301 redirects: old /product/ URLs to new /products/category/ URLs
  RewriteRule ^product/kd001-a3/?$ /products/adjustable-bed-frames/kd001-a3/ [R=301,L]
  RewriteRule ^product/kd005-a1/?$ /products/adjustable-bed-frames/ [R=302,L]
  RewriteRule ^product/kd008-a1/?$ /products/adjustable-bed-frames/ [R=302,L]
  RewriteRule ^product/kd010-a2/?$ /products/adjustable-bed-frames/kd010-a2/ [R=301,L]
  RewriteRule ^product/kd011-a3/?$ /products/adjustable-bed-frames/kd011-a3/ [R=301,L]
  RewriteRule ^product/kd004-b1/?$ /products/mattresses/kd004-b1/ [R=301,L]
  RewriteRule ^product/yj001-1/?$  /products/leisure-chairs/yj001-a01/ [R=301,L]
  RewriteRule ^products/leisure-chairs/yj001-1/?$ /products/leisure-chairs/yj001-a01/ [R=301,L]
  RewriteRule ^products/leisure-chairs/yj001-3/?$ /products/leisure-chairs/yj001-a01/ [R=301,L]
  RewriteRule ^products/leisure-chairs/yj002-1/?$ /products/leisure-chairs/yj001-a02/ [R=301,L]

  # Models that are no longer promoted (owner decision 2026-11-02). TEMPORARY (302) redirects on purpose: switch to a
  # permanent redirect only after the owner approves and Search Console data has been checked.
  RewriteRule ^product/kr00[1-4]/?$ /products.html [R=302,L]
  RewriteRule ^products/adjustable-bed-frames/(kd001-a6|kd001-a7|kd001-a8|kd004-a3|kd005-a1|kd006-a1|kd007-a1|kd008-a1)/?$ /products/adjustable-bed-frames/ [R=302,L]
  RewriteRule ^products/mattresses/(kd001-b1|kd001-b2|kd001-b3|kd002-b1|kd002-b2|kd004-b3|kd008-b1)/?$ /products/mattresses/ [R=302,L]
  RewriteRule ^products/(smart-beds|bed-bases)(/.*)?$ /products.html [R=302,L]
  RewriteRule ^blog/kr-series-smart-beds-canton-fair-2025/?$ /news.html [R=302,L]
  RewriteRule ^blog/wall-hugger-frame-buyer-notes/?$ /blog/zero-clearance-frame-buyer-notes/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Performance: compress text assets and let browsers cache static files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
</IfModule>
